#!/usr/bin/env python3
import sys

import gi

gi.require_version("Gtk", "4.0")
gi.require_version("Adw", "1")
from gi.repository import Adw  # noqa: E402

APP_ID = "io.github.FrogPak.Example"


class Example(Adw.Application):
    def __init__(self):
        super().__init__(application_id=APP_ID)

    def do_activate(self):
        page = Adw.StatusPage(
            icon_name=APP_ID,
            title="Hello from a pond",
            description="Built by the FrogPak releaser and installed from a FrogPak pond.",
        )
        view = Adw.ToolbarView(content=page)
        view.add_top_bar(Adw.HeaderBar())
        window = Adw.ApplicationWindow(application=self, title="FrogPak Example",
                                       default_width=420, default_height=360, content=view)
        window.present()


if __name__ == "__main__":
    sys.exit(Example().run(sys.argv))
